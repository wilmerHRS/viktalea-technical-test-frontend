# URLs de los "pods" del backend (separadas por coma). Con dos, el escenario de varios pods
# reparte las requests entre ambos. Levanta el segundo con: PORT=3001 npm run dev (en el backend).
VITE_API_URLS=http://localhost:3000,http://localhost:3001

# Secreto con el que la pasarela simulada firma los webhooks. Debe coincidir con WEBHOOK_SECRET
# del backend. Es un valor de desarrollo: en producción la firma la hace la pasarela, nunca el navegador.
VITE_WEBHOOK_SECRET=local_webhook_secret_change_me
